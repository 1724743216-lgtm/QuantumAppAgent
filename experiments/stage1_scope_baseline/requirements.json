{
  "task": "金融欺诈检测二分类",
  "task_type": "classification",
  "description": "使用VQC量子机器学习方法对信用卡交易数据进行欺诈/正常二分类，与经典基线对比",
  "data": {
    "source": "合成信用卡欺诈检测数据集（模拟Kaggle Credit Card Fraud Detection特征结构）",
    "features": 28,
    "samples_total": 1000,
    "fraud_ratio": 0.2,
    "train_ratio": 0.8,
    "test_ratio": 0.2,
    "split_seed": 42
  },
  "input": {
    "type": "数值特征向量",
    "dim": 28,
    "preprocessing": "StandardScaler标准化 + PCA降维至4维（匹配量子比特数）"
  },
  "output": {
    "type": "二分类标签",
    "classes": ["正常(0)", "欺诈(1)"]
  },
  "primary_metric": "f1_score",
  "metric_direction": "higher_is_better",
  "secondary_metrics": ["auc_roc", "precision", "recall", "accuracy"],
  "baseline": {
    "method": "Logistic Regression",
    "expected_range": "F1 >= 0.80"
  },
  "quantum_method": {
    "algorithm": "VQC (Variational Quantum Classifier)",
    "encoding": "angle_encoding",
    "n_qubits": 4,
    "ansatz_layers": 2,
    "output": "z_expectation",
    "optimizer": "Adam (lr=0.01)",
    "backend": "StatevectorSimulator"
  },
  "cloud_showcase": {
    "frontend": "qccp-web Vue SFC页面",
    "backend": "Python FastAPI服务",
    "endpoints": ["/health", "/api/info", "/api/predict"]
  },
  "constraints": [
    "本地模拟器执行",
    "不涉及真实硬件",
    "前端遵循qccp设计规范"
  ]
}
